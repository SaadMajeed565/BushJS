# Environment
NODE_ENV=development

# Server
APP_PORT=3000
APP_URL=http://localhost:3000

# Database (MongoDB)
DATABASE_URL=mongodb://localhost:27017/bushjs
DB_DRIVER=mongodb
DB_HOST=localhost
DB_PORT=27017
DB_DATABASE=bushjs
DB_POOL_MAX=10
DB_POOL_MIN=2

# Authentication — both REQUIRED in production (boot throws if missing)
AUTH_JWT_SECRET=
AUTH_SESSION_SECRET=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000

# Cache
CACHE_DRIVER=memory
CACHE_PATH=storage/cache

# Redis (optional, for cache driver `redis`)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
